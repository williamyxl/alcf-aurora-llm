#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N smoke-opt125m
#PBS -j oe
# Submit from the repo root:   qsub -v REPO=$PWD common/vllm/smoke_opt125m.pbs      (override queue: qsub -q debug-scaling ...)
cd "${REPO:?pass -v REPO=<repo root>}"
source common/env.sh
# 10-minute install check for the vLLM stack: opt-125m (fp16) on 1 tile, single-stream + 128-way. Expect ~160 tok/s single, ~16k tok/s conc.
common/vllm/run_bench.sh smoke_opt125m "$MODELS/opt-125m/fp16-hf" 1 --tp 1 --dtype float16 --max-model-len 2048 --mns 128 --mem-util 0.5 --eager --no-chat

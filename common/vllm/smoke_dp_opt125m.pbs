#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N smoke-dp
#PBS -j oe
# Submit from the repo root:   qsub -v REPO=$PWD common/vllm/smoke_dp_opt125m.pbs      (override queue: qsub -q debug-scaling ...)
cd "${REPO:?pass -v REPO=<repo root>}"
source common/env.sh
# Checks the data-parallel launcher (common/vllm/run_dp.sh) with opt-125m: 4 engines x 1 tile. Expect 4 CONC_JSON lines + NODE_AGGREGATE.
NREP=4 TPE=1 KVGIB=4 STAGGER=10 common/vllm/run_dp.sh smoke_dp "$MODELS/opt-125m/fp16-hf" \
  --dtype float16 --max-model-len 2048 --max-num-seqs 64 --num-prompts 128 --max-tokens 64 --gpu-mem-util 0.5

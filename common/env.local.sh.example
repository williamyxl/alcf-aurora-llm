# Copy to common/env.local.sh (gitignored) and edit. Everything is optional; defaults are in env.sh.
export PBS_ACCOUNT=MatSciAI                 # your ALCF allocation
export PBS_FS=flare                         # filesystem named in -l filesystems=
# Where weights, llama.cpp builds and the vLLM overlays live. Put it on project storage; ~4.5 TB if you fetch every model.
export DATA=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/alcf-aurora-llm/data
# export FW=2025                            # use the older frameworks module (legacy gpt-oss recipe)
# export LLAMA=gptoss                       # default llama.cpp build for scripts that do not set it

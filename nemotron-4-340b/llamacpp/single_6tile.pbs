#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N n4-ll-single
#PBS -j oe
# Submit from the repo root:   qsub -v REPO=$PWD nemotron-4-340b/llamacpp/single_6tile.pbs      (override queue: qsub -q debug-scaling ...)
cd "${REPO:?pass -v REPO=<repo root>}"
source common/env.sh
# Dense 340B i1-Q4_K_M, 1 x llama-server over 6 tiles (layer split): 2.4 tok/s decode, TTFT 2.4 s, prefill 11 tok/s.
LLAMA=inkling GGUF="$MODELS/nemotron-4-340b/i1-Q4_K_M.gguf" SERVED=nemotron-4-340b MODE=fullxpu NREP=1 TPE=6 NPAR=${NPAR:-1} NTHREADS=64 CTX=4096 LEVELS="1 4 8" common/llamacpp/serve_bench.sh

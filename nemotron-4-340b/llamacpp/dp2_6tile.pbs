#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N n4-ll-dp
#PBS -j oe
# Submit from the repo root:   qsub -v REPO=$PWD nemotron-4-340b/llamacpp/dp2_6tile.pbs      (override queue: qsub -q debug-scaling ...)
cd "${REPO:?pass -v REPO=<repo root>}"
source common/env.sh
# 2 x 6-tile data parallel behind lb.py: 4.4 / 6.0 / 6.6 tok/s aggregate at c=1/4/8 (0.05 req/s). (3 x 4-tile gave ~9.9 tok/s in an earlier run.)
LLAMA=inkling GGUF="$MODELS/nemotron-4-340b/i1-Q4_K_M.gguf" SERVED=nemotron-4-340b MODE=fullxpu NREP=${NREP:-2} TPE=${TPE:-6} NPAR=8 NTHREADS=16 CTX=4096 LEVELS="1 4 8" common/llamacpp/serve_bench.sh

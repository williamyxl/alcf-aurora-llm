#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:59:00
#PBS -q debug-scaling
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N gptoss-bf16
#PBS -j oe
# Submit from the repo root:   qsub -v REPO=$PWD gpt-oss-120b/vllm/bf16_tp8.pbs      (override queue: qsub -q debug-scaling ...)
cd "${REPO:?pass -v REPO=<repo root>}"
source common/env.sh
# BF16 (218 GB), TP8: 24.5 tok/s single-stream, 2459 tok/s at 128-way. Slower and 2x the memory of MXFP4; for reference.
common/vllm/run_bench.sh gptoss_bf16 "$MODELS/gpt-oss-120b/bf16-hf" 8 --tp 8 --max-model-len 4096 --mns 128 --kv-gib 12 --eager

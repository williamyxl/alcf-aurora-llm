#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:59:00
#PBS -q debug-scaling
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N gptoss-single
#PBS -j oe
# Submit from the repo root:   qsub -v REPO=$PWD gpt-oss-120b/vllm/single_graph.pbs      (override queue: qsub -q debug-scaling ...)
cd "${REPO:?pass -v REPO=<repo root>}"
source common/env.sh
# MXFP4, 1 x TP4, XPU graph: 60.0 tok/s single-stream decode (26.3 eager).   Tag -> logs/gptoss_single_graph.out (PERF_JSON=)
XPUGRAPH=1; export XPUGRAPH; vllm_env; vllm_overlays; vllm_tiles 0 3; vllm_cache gptoss_single
"$FWPY" common/vllm/bench_single.py --model "$MODELS/gpt-oss-120b/mxfp4-hf" --tp 4 --max-model-len 4096 --max-num-seqs 1 \
  --gpu-mem-util 0.85 --kv-cache-memory-gib 8 --max-tokens 128 --no-enforce-eager --tag gptoss_single_graph > "$LOGS/gptoss_single_graph.out" 2>&1
grep -h PERF_JSON= "$LOGS/gptoss_single_graph.out"

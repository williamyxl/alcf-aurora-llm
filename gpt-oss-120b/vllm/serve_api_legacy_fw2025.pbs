#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=24:00:00
#PBS -q capacity
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N gptoss-api25
#PBS -j oe
# Submit from the repo root:   qsub -v REPO=$PWD gpt-oss-120b/vllm/serve_api_legacy_fw2025.pbs      (override queue: qsub -q debug-scaling ...)
cd "${REPO:?pass -v REPO=<repo root>}"
source common/env.sh; export VLLM_XPU_FUSED_MOE_USE_REF=${VLLM_XPU_FUSED_MOE_USE_REF:-0}
# frameworks/2025.3.1 variant (vllm 0.15): needs VLLM_XPU_FUSED_MOE_USE_REF=1. 3 x TP4, native 131072 context, ~4565 tok/s @128-way.
FW=2025 VLLM_XPU_FUSED_MOE_USE_REF=1 MODEL="$MODELS/gpt-oss-120b/mxfp4-hf" SERVED_NAME=gpt-oss-120b NREP=3 TPE=4 MML=131072 MNS=128 KVGIB=40 \
EXTRA_ARGS="--enable-auto-tool-choice --tool-call-parser openai" common/vllm/serve_api.sh

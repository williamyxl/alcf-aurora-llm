#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:59:00
#PBS -q debug-scaling
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N vg-fwmp
#PBS -j oe
set -o pipefail
CAMP=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/alcf-aurora-llm/gpt-oss-120b/build-vllm-xpu/opus4.8-new_campaign
MODEL=${MODEL}; TP=${TP:-2}; MML=${MML:-4096}; MNS=${MNS:-2}; MEMUTIL=${MEMUTIL:-0.85}; KVGIB=${KVGIB:-8}; MAXTOK=${MAXTOK:-128}; TAG=${TAG:-fwmp}
source /opt/aurora/26.26.0/spack/unified/1.1.1/install/linux-x86_64/miniforge3-25.11.0-1-khkcc6i/etc/profile.d/conda.sh
conda activate /opt/aurora/26.26.0/frameworks/aurora_frameworks-2025.3.1
export ZE_FLAT_DEVICE_HIERARCHY=FLAT ZES_ENABLE_SYSMAN=1 HF_HUB_OFFLINE=1 TMPDIR=/tmp
export VLLM_XPU_FUSED_MOE_USE_REF=1
export VLLM_WORKER_MULTIPROC_METHOD=spawn
JOBTAG=${PBS_JOBID:-$$}; export TRITON_CACHE_DIR=/tmp/triton_${JOBTAG} SYCL_CACHE_DIR=/tmp/sycl_${JOBTAG}; mkdir -p "$TRITON_CACHE_DIR" "$SYCL_CACHE_DIR"
export CCL_PROCESS_LAUNCHER=hydra CCL_ATL_TRANSPORT=ofi CCL_ZE_IPC_EXCHANGE=sockets CCL_WORKER_COUNT=1 FI_PROVIDER=cxi
echo "host=$(hostname) date=$(date -Is)"; python -c "import vllm,torch;print('vllm',vllm.__version__,'xpu',torch.xpu.device_count())"
KV_FLAG=""; [ -n "${KVGIB:-}" ] && KV_FLAG="--kv-cache-memory-gib $KVGIB"
python "$CAMP/vllm_bench2.py" --model "$MODEL" --tp "$TP" --max-model-len "$MML" \
  --max-num-seqs "$MNS" --gpu-mem-util "$MEMUTIL" --max-tokens "$MAXTOK" --enforce-eager $KV_FLAG --tag "$TAG"
echo "VLLM_RUN_DONE date=$(date -Is)"

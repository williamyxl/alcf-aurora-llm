#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:15:00
#PBS -q debug-scaling
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N xpu-kprobe
#PBS -j oe

LOG=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/alcf-aurora-llm/gpt-oss-120b/build-vllm-xpu/opus4.8-new_campaign/logs/kernel_probe.log
exec > "$LOG" 2>&1
echo "START $(date -Is) host=$(hostname)"
source /lus/flare/projects/MatSciAI/xiaoliyan/miniforge3/etc/profile.d/conda.sh
conda activate /lus/flare/projects/MatSciAI/xiaoliyan/software/conda/envs/vllm-xpu
export ZE_FLAT_DEVICE_HIERARCHY=FLAT ONEAPI_DEVICE_SELECTOR=level_zero:gpu ZES_ENABLE_SYSMAN=1
export PYTHONFAULTHANDLER=1
python - <<'PY'
import torch
print("torch", torch.__version__, "dev", torch.xpu.get_device_properties(0).name)

# 1) bare torch-XPU matmul (baseline: does torch-XPU compute work on PVC?)
a = torch.randn(1024,1024, device="xpu", dtype=torch.bfloat16)
b = torch.randn(1024,1024, device="xpu", dtype=torch.bfloat16)
c = (a@b); torch.xpu.synchronize()
print("torch matmul OK, c.sum=", float(c.float().sum()))

# 2) import vllm_xpu_kernels and call a simple custom op (rms_norm / silu)
import vllm_xpu_kernels._C as _C  # noqa
print("vllm_xpu_kernels._C import OK")
import vllm_xpu_kernels._moe_C as _moe  # noqa
print("vllm_xpu_kernels._moe_C import OK")

# arch flags
try:
    print("is_xe2_arch", torch.ops._xpu_C.is_xe2_arch(), "is_xe3_arch", torch.ops._xpu_C.is_xe3_arch())
except Exception as e:
    print("arch flags err", e)

# 3) try a trivial silu_and_mul custom op if present
import torch as T
x = T.randn(8, 256, device="xpu", dtype=T.bfloat16)
out = T.empty(8,128, device="xpu", dtype=T.bfloat16)
try:
    T.ops._C.silu_and_mul(out, x); T.xpu.synchronize()
    print("silu_and_mul OK sum=", float(out.float().sum()))
except Exception as e:
    print("silu_and_mul err:", type(e).__name__, e)
print("ALL PROBES DONE")
PY
echo "COMPLETION_EXIT=$?"
echo "DONE $(date -Is)"

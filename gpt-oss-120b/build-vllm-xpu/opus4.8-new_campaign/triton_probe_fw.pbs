#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:12:00
#PBS -q debug-scaling
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N triton-fw
#PBS -j oe
LOG=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/alcf-aurora-llm/gpt-oss-120b/build-vllm-xpu/opus4.8-new_campaign/logs/triton_probe_fw.log
exec > "$LOG" 2>&1
source /opt/aurora/26.26.0/spack/unified/1.1.1/install/linux-x86_64/miniforge3-25.11.0-1-khkcc6i/etc/profile.d/conda.sh
conda activate /opt/aurora/26.26.0/frameworks/aurora_frameworks-2025.3.1
export ZE_FLAT_DEVICE_HIERARCHY=FLAT ONEAPI_DEVICE_SELECTOR=level_zero:gpu ZES_ENABLE_SYSMAN=1 PYTHONFAULTHANDLER=1 TMPDIR=/tmp
export TRITON_CACHE_DIR=/tmp/triton_cache_fw_$$
which python; python -c "import torch,triton;print('torch',torch.__version__,'triton',triton.__version__)"
cd /lus/flare/projects/MatSciAI/xiaoliyan/workdir/alcf-aurora-llm/gpt-oss-120b/build-vllm-xpu/opus4.8-new_campaign
python triton_probe.py
echo "COMPLETION_EXIT=$?"

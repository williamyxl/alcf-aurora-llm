#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:15:00
#PBS -q debug-scaling
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N triton-probe
#PBS -j oe
LOG=/lus/flare/projects/MatSciAI/xiaoliyan/workdir/alcf-aurora-llm/gpt-oss-120b/build-vllm-xpu/opus4.8-new_campaign/logs/triton_probe.log
exec > "$LOG" 2>&1
set -o pipefail
echo "START $(date -Is) host=$(hostname)"
source /lus/flare/projects/MatSciAI/xiaoliyan/miniforge3/etc/profile.d/conda.sh
conda activate /lus/flare/projects/MatSciAI/xiaoliyan/software/conda/envs/vllm-xpu
export LD_LIBRARY_PATH=/opt/aurora/26.26.0/spack/unified/1.1.1/install/linux-x86_64/gcc-13.4.0-hgnyg4p/lib64:${LD_LIBRARY_PATH:-}
export ZE_FLAT_DEVICE_HIERARCHY=FLAT ONEAPI_DEVICE_SELECTOR=level_zero:gpu ZES_ENABLE_SYSMAN=1
export PYTHONFAULTHANDLER=1 TMPDIR=/tmp
export TRITON_CACHE_DIR=/tmp/triton_cache_probe_$$
export TRITON_INTEL_DEVICE_EXTENSIONS="cl_intel_subgroup_matrix_multiply_accumulate cl_intel_subgroup_matrix_multiply_accumulate_tensor_float32 cl_intel_subgroup_2d_block_io cl_intel_bfloat16_conversions"
export INJECT_PYTORCH=True
cd /lus/flare/projects/MatSciAI/xiaoliyan/workdir/alcf-aurora-llm/gpt-oss-120b/build-vllm-xpu/opus4.8-new_campaign
python triton_probe.py
echo "COMPLETION_EXIT=$? $(date -Is)"

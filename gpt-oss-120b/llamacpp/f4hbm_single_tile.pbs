#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:40:00
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N gptoss-f4hbm
#PBS -j oe
# Submit from the repo root:   qsub -v REPO=$PWD gpt-oss-120b/llamacpp/f4hbm_single_tile.pbs      (override queue: qsub -q debug-scaling ...)
cd "${REPO:?pass -v REPO=<repo root>}"
source common/env.sh
# Best single-user recipe: 1 tile, MoE experts on CPU, HBM NUMA bind ("F4_hbm"). 42.4 tok/s decode (41.6 earlier, same engine).
LLAMA=gptoss GGUF="$MODELS/gpt-oss-120b/mxfp4.gguf" MODE=moecpu CTX=${CTX:-4096} common/llamacpp/oneshot.sh 2>&1 | tee "$LOGS/gptoss_llama_f4hbm.log"

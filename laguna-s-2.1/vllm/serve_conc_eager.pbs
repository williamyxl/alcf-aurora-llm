#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:59:00
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N laguna-eager
#PBS -j oe
# Submit from the repo root:   qsub -v REPO=$PWD laguna-s-2.1/vllm/serve_conc_eager.pbs      (override queue: qsub -q debug-scaling ...)
cd "${REPO:?pass -v REPO=<repo root>}"
source common/env.sh
# Eager reference: 13.6 tok/s single-stream, 1352 tok/s at 128-way.
common/vllm/run_bench.sh laguna_eager "$MODELS/laguna-s-2.1/bf16-hf" 8 --tp 8 --max-model-len 8192 --mns 128 --kv-gib 12 --eager

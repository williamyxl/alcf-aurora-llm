#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:59:00
#PBS -q debug
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N laguna-graph
#PBS -j oe
# Submit from the repo root:   qsub -v REPO=$PWD laguna-s-2.1/vllm/serve_conc_graph.pbs      (override queue: qsub -q debug-scaling ...)
cd "${REPO:?pass -v REPO=<repo root>}"
source common/env.sh
# BF16, TP8, XPU graph: 36.6 tok/s single-stream, 2342 tok/s / 18.3 req/s at 128-way (eager: 13.6 / 1352). Quality OK.
# Load takes ~13 min (219 GB from Lustre).  Output: logs/laguna_graph.out (SERVE_JSON=)
XPUGRAPH=1 common/vllm/run_bench.sh laguna_graph "$MODELS/laguna-s-2.1/bf16-hf" 8 --tp 8 --max-model-len 8192 --mns 128 --kv-gib 12

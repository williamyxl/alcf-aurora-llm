#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=24:00:00
#PBS -q capacity
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N laguna-api
#PBS -j oe
# Submit from the repo root:   qsub -v REPO=$PWD laguna-s-2.1/vllm/serve_api.pbs      (override queue: qsub -q debug-scaling ...)
cd "${REPO:?pass -v REPO=<repo root>}"
source common/env.sh
# OpenAI-compatible endpoint: 1 x TP8 (the 219 GB BF16 needs all 8 tiles), XPU graph. Endpoint -> logs/ENDPOINT.txt
XPUGRAPH=1 EAGER_FLAG= MODEL="$MODELS/laguna-s-2.1/bf16-hf" SERVED_NAME=laguna-s-2.1 NREP=1 TPE=8 MML=${MML:-8192} MNS=128 KVGIB=${KVGIB:-12} common/vllm/serve_api.sh

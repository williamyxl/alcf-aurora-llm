#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:59:00
#PBS -q debug-scaling
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N ultra-3-5-super-vl
#PBS -j oe
# Submit from the repo root:   qsub -v REPO=$PWD nemotron-3-5-super-vl/vllm/serve_int4_patched.pbs      (override queue: qsub -q debug-scaling ...)
cd "${REPO:?pass -v REPO=<repo root>}"
source common/env.sh
# INT4 w4a16 (293 GB), TP8, eager, WITH the top-k=22 _moe_C overlay: 7.8 tok/s single, 115 tok/s at 16-way, quality OK.
# Without the overlay: "RuntimeError: Unsupported TopK value" (Ultra routes top-22 of 512 experts).
# Prereq: common/vllm/setup_overlay.sh kernels  (compute node).  Load ~33 min: use the full 59 min walltime.
# mns>16 / ctx>2048 ran out of XPU resources on one node.
OVERLAY_KERNELS=1 common/vllm/run_bench.sh ultra-3-5-super-vl "$MODELS/nemotron-3-5-super-vl/w4a16-hf" 8 --tp 8 --max-model-len 2048 --mns 16 --kv-gib 4 --mem-util 0.92 --eager --nprompts 32

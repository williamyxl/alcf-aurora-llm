#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:59:00
#PBS -q debug-scaling
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N inkling-hf-dl
#PBS -o /lus/flare/projects/MatSciAI/xiaoliyan/workdir/alcf-aurora-llm/inkling/build-llamacpp-sycl/logs/download_hf.out
#PBS -j oe

# Resumable HF download of thinkingmachines/Inkling (~2TB BF16).
# Re-qsub until log shows DOWNLOAD_OK=1.
set -euo pipefail
export http_proxy=http://proxy.alcf.anl.gov:3128
export https_proxy=http://proxy.alcf.anl.gov:3128
mkdir -p /lus/flare/projects/MatSciAI/xiaoliyan/workdir/alcf-aurora-llm/inkling/build-llamacpp-sycl/logs
bash /lus/flare/projects/MatSciAI/xiaoliyan/workdir/alcf-aurora-llm/inkling/download_inkling_hf.sh

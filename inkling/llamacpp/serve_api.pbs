#!/bin/bash -l
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=00:59:00
#PBS -q debug-scaling
#PBS -A MatSciAI
#PBS -l filesystems=flare
#PBS -N ink-ll-api
#PBS -j oe
# Submit from the repo root:   qsub -v REPO=$PWD inkling/llamacpp/serve_api.pbs      (override queue: qsub -q debug-scaling ...)
cd "${REPO:?pass -v REPO=<repo root>}"
source common/env.sh
# llama-server OpenAI endpoint over 12 tiles (UD-IQ1_S).
source common/lib.sh; GGUF="$(first_shard "$MODELS/inkling/UD-IQ1_S-gguf")"
LLAMA=inkling GGUF="$GGUF" SERVED=inkling MODE=fullxpu NREP=1 TPE=12 NPAR=${NPAR:-8} NTHREADS=32 CTX=${CTX:-8192} LEVELS="1 4 8" common/llamacpp/serve_bench.sh
